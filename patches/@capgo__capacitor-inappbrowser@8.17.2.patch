+    /**
+     * User-Agent Client Hints still advertise "Android WebView" after setUserAgentString.
+     * Google Sign-In rejects that brand even when the User-Agent string is Chrome.
+     */
+    private void applyChromeClientHints(WebSettings settings, String userAgent) {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.USER_AGENT_METADATA)) {
+            return;
+        }
+        String major = "155";
+        String full = "155.0.8059.40";
+        java.util.regex.Matcher matcher = Pattern.compile("Chrome/(\\d+)(?:\\.(\\d+)\\.(\\d+)\\.(\\d+))?").matcher(userAgent);
+        if (matcher.find()) {
+            major = matcher.group(1);
+            if (matcher.group(2) != null) {
+                full = matcher.group(1) + "." + matcher.group(2) + "." + matcher.group(3) + "." + matcher.group(4);
+                if ("0".equals(matcher.group(2)) && "0".equals(matcher.group(3)) && "0".equals(matcher.group(4))) {
+                    full = major + ".0.8059.40";
+                }
+            }
+        }
+        boolean mobile = userAgent.contains("Mobile");
+        String platform = userAgent.contains("Macintosh") ? "macOS" : (userAgent.contains("Windows") ? "Windows" : "Android");
+        String platformVersion = "macOS".equals(platform) ? "15.6.0" : ("Windows".equals(platform) ? "15.0.0" : "14.0.0");
+        String model = "Android".equals(platform) ? "Pixel 8" : "";
+        List<UserAgentMetadata.BrandVersion> brands = Arrays.asList(
+            new UserAgentMetadata.BrandVersion.Builder().setBrand("Chromium").setMajorVersion(major).setFullVersion(full).build(),
+            new UserAgentMetadata.BrandVersion.Builder().setBrand("Google Chrome").setMajorVersion(major).setFullVersion(full).build(),
+            new UserAgentMetadata.BrandVersion.Builder().setBrand("Not-A.Brand").setMajorVersion("24").setFullVersion("24.0.0.0").build()
+        );
+        WebSettingsCompat.setUserAgentMetadata(
+            settings,
+            new UserAgentMetadata.Builder()
+                .setBrandVersionList(brands)
+                .setFullVersion(full)
+                .setPlatform(platform)
+                .setPlatformVersion(platformVersion)
+                .setArchitecture("arm")
+                .setModel(model)
+                .setMobile(mobile)
+                .setBitness(64)
+                .setWow64(false)
+                .build()
+        );
     }
 
