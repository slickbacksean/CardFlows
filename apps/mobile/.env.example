# P4 release env layout. Copy to .env.local for local runs; for EAS builds set these with
# `eas env:create --environment <development|preview|production> --name … --value …`.
# Every EXPO_PUBLIC_* value is PUBLIC: Metro inlines it into the JS bundle. Never put a secret here.
# Local runs: everything is optional. Preview/production builds REQUIRE EXPO_PUBLIC_API_URL
# (public, not loopback/LAN); app.config.ts refuses to build without it. Sentry/PostHog stay optional.

# CardFlow API base URL, e.g. https://api.cardflow.app (unset in local dev: local dev API)
EXPO_PUBLIC_API_URL=

# Sentry DSN for the mobile project (unset: crash reporting off). Scrubbed: no photos, emails, tokens.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog project key (unset: analytics off). Events also need the user's in-app opt-in.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional extras (see docs/RELEASE_ENV.md for which profiles may use them)
EXPO_PUBLIC_CARD_FLOW_APP_KEY=
EXPO_PUBLIC_CARD_FLOW_GRADE_JOBS=
# development/preview only; production builds fail if set
EXPO_PUBLIC_CARD_FLOW_LIVESTREAM_TIMING=
EXPO_PUBLIC_HUDS_URL=
