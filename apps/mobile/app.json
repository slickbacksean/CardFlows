{
  "expo": {
    "name": "CardFlow",
    "slug": "cardflow",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cardflow",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CardFlow to access your camera to scan cards"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CardFlow to access your photos to select card images",
          "cameraPermission": "Allow CardFlow to access your camera to capture card images"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardflows.mobile"
    },
    "android": {
      "package": "com.cardflows.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
