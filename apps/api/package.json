{
  "name": "@cardflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:grade-e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --name mvp_crm_schema",
    "db:migrate": "tsx src/db/apply-migration.ts",
    "build:phash-index": "tsx scripts/build-english-phash-index.ts"
  },
  "dependencies": {
    "@cardflow/shared": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@tcgdex/sdk": "^2.9.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.8",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.5",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.1",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
