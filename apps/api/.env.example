# Copy to apps/api/.env locally if you want named values.
# Leave these empty. Never put vendor secrets on the device.

CARD_FLOW_STORE=
CARD_FLOW_SQLITE_PATH=
CARD_FLOW_DEV_AUTO_SESSION=
# Browser origins allowed to call this API, comma-separated. Empty allows none. Native apps do not need CORS.
CARD_FLOW_CORS_ORIGINS=
# Server-only invite codes. Empty uses the private-beta defaults in the API process. Never on the phone.
CARD_FLOW_INVITE_ALEX=
CARD_FLOW_INVITE_JORDAN=
CARD_FLOW_TCGDEX_CATALOG_ENABLED=
# Local Capture identify. Empty in CI. true reads persisted stills through OBB + pHash.
CARD_FLOW_OBB_PHASH_ENABLED=
# Gitignored local English TCGdex pHash index, e.g. data/phash-index.json. Never commit the file.
# Generate with: pnpm --filter @cardflow/api build:phash-index
# Tests keep packages/shared/fixtures/obb-phash-index.json.
# Capture stills and livestream identityHash classify both read this file.
CARD_FLOW_OBB_PHASH_INDEX=
# Gitignored local YOLO11n-OBB, e.g. models/yolo11n-obb.onnx. Never commit the file.
CARD_FLOW_OBB_ONNX_PATH=
# Required before loading gitignored Ultralytics YOLO `.onnx` weights (AGPL).
CARD_FLOW_ULTRALYTICS_AGPL_ACCEPTED=
# Reserved identity ONNX. Empty until a live-video identity head exists; classify uses the pHash index.
CARD_FLOW_LIVE_IDENTITY_ONNX_PATH=
# OpenCLIP livestream sidecar (pokemon-scanner pipeline). Prefer when identityCropJpeg is posted.
# See services/live-identity-openclip/README.md and docs/LIVE_VISUAL_MODEL.md. Never PokéCollector Gemini.
CARD_FLOW_LIVE_IDENTITY_OPENCLIP_URL=
CARD_FLOW_LIVE_IDENTITY_OPENCLIP_TOKEN=
CARD_FLOW_LIVE_IDENTITY_OPENCLIP_TIMEOUT_MS=
CARD_FLOW_CARDSIGHT_IDENTIFY_ENABLED=
CARDSIGHT_API_KEY=
CARDSIGHT_MOCK_SCENARIO=
CARD_FLOW_POKECOLLECTOR_URL=
CARD_FLOW_POKECOLLECTOR_ENABLED=
CARD_FLOW_POKECOLLECTOR_TOKEN=
# Photo pre-grade = the free, offline cardgrading library in vendor/cardgrading
# (OpenCV + NumPy + Pillow, no model call). Empty or true = on; false = kill switch.
CARD_FLOW_GRADE_ESTIMATE_ENABLED=
# Python with vendor/cardgrading/requirements.txt. Empty uses apps/api/.venv/bin/python:
#   python3 -m venv .venv && .venv/bin/pip install --only-binary=:all: -r vendor/cardgrading/requirements.txt
CARDFLOW_GRADE_CARD_PYTHON=
# Not on the grade path. The API ignores these; kept only for the
# services/psa-grade-predictor experiment.
CARD_FLOW_PSA_GRADE_URL=
CARD_FLOW_PSA_GRADE_TOKEN=
CARD_FLOW_PSA_GRADE_TIMEOUT_MS=
# PokeTrace slab comps on Prepare. Server-only key. Fail soft when off.
CARD_FLOW_POKETRACE_ENABLED=
POKETRACE_API_KEY=
# Public host only, e.g. https://api.poketrace.com/v1. Host-only values are normalized. Never a phone secret.
POKETRACE_API_URL=
# Prefer unset over empty. Empty PORT= is treated as 0 (random) — API defaults to 3001.
PORT=
