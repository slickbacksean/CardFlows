# Copy to apps/api/.env locally if you want named values.
# Leave these empty. Never put vendor secrets on the device.

CARD_FLOW_STORE=
CARD_FLOW_SQLITE_PATH=
CARD_FLOW_DEV_AUTO_SESSION=
# Browser origins allowed to call this API, comma-separated. Empty allows none. Native apps do not need CORS.
CARD_FLOW_CORS_ORIGINS=
# Browse-only guest sessions (24 h): guests look around, sign up to scan, grade or save. Off unless true.
CARD_FLOW_GUEST_BROWSE=
# Server-only tester invite codes. Empty = that tester cannot use a code (fail closed). Never on the phone.
CARD_FLOW_INVITE_ALEX=
CARD_FLOW_INVITE_JORDAN=
CARD_FLOW_TCGDEX_CATALOG_ENABLED=
# Local Capture identify. Empty in CI. true reads persisted stills through OBB + pHash.
CARD_FLOW_OBB_PHASH_ENABLED=
# Gitignored local English TCGdex pHash index, e.g. data/phash-index.json. Never commit the file.
# Generate with: pnpm --filter @cardflow/api build:phash-index
# Tests keep packages/shared/fixtures/obb-phash-index.json.
# Capture stills and livestream identityHash classify both read this file.
CARD_FLOW_OBB_PHASH_INDEX=
# Gitignored local YOLO11n-OBB, e.g. models/yolo11n-obb.onnx. Never commit the file.
CARD_FLOW_OBB_ONNX_PATH=
# Required before loading gitignored Ultralytics YOLO `.onnx` weights (AGPL).
CARD_FLOW_ULTRALYTICS_AGPL_ACCEPTED=
# Reserved identity ONNX. Empty until a live-video identity head exists; classify uses the pHash index.
CARD_FLOW_LIVE_IDENTITY_ONNX_PATH=
# OpenCLIP livestream sidecar (pokemon-scanner pipeline). Prefer when identityCropJpeg is posted.
# See services/live-identity-openclip/README.md and docs/LIVE_VISUAL_MODEL.md. Never PokéCollector Gemini.
CARD_FLOW_LIVE_IDENTITY_OPENCLIP_URL=
CARD_FLOW_LIVE_IDENTITY_OPENCLIP_TOKEN=
CARD_FLOW_LIVE_IDENTITY_OPENCLIP_TIMEOUT_MS=
CARD_FLOW_CARDSIGHT_IDENTIFY_ENABLED=
# CardMagic for saved grade photos (docs/CARDMAGIC.md). Off unless on + CARDSIGHT_API_KEY.
CARD_FLOW_CARDMAGIC=
# Calls reserved for card ID so CardMagic cannot burn the free plan.
# Default 600 when CARD_FLOW_CARDSIGHT_MONTHLY_BUDGET is 750 (or unset → 750); else ~80% of the cap.
# CardMagic runs only while total CardSight calls this month are below cap − reserve.
CARD_FLOW_CARDMAGIC_ID_RESERVE=
# CardSight identify adapter (PR 90). Off unless on + key.
CARD_FLOW_CARDSIGHT_ADAPTER=
CARDSIGHT_API_KEY=
CARDSIGHT_MOCK_SCENARIO=
CARD_FLOW_POKECOLLECTOR_URL=
CARD_FLOW_POKECOLLECTOR_ENABLED=
# Admin JWT for PokéCollector (creates one user per PokeSniper user). Expires after 7 days.
CARD_FLOW_POKECOLLECTOR_TOKEN=
# Optional instead of the token: PokeSniper mints the admin token itself and again on a 401.
CARD_FLOW_POKECOLLECTOR_ADMIN_USERNAME=
CARD_FLOW_POKECOLLECTOR_ADMIN_PASSWORD=
# Per-user PokéCollector accounts (opaque usernames, random encrypted passwords). OFF unless
# `true`, and even then only with the pepper and key below (no fallback). Keep it unset in
# staging/prod until the opaque-accounts PR is merged and `pokecollector:relink` has run.
CARD_FLOW_POKECOLLECTOR_ACCOUNTS=
# 32+ random characters (openssl rand -base64 48). Changing it renames every user: don't.
CARD_FLOW_POKECOLLECTOR_USER_PEPPER=
# 32-byte AES-256-GCM key, base64 or 64 hex (openssl rand -base64 32). Losing it loses every link.
CARD_FLOW_POKECOLLECTOR_LINK_KEY=
# Key rotation only: earlier link keys, comma-separated (read, never written).
CARD_FLOW_POKECOLLECTOR_PREVIOUS_LINK_KEYS=
# Photo pre-grade = the free, offline cardgrading library in vendor/cardgrading
# (OpenCV + NumPy + Pillow, no model call). Empty or true = on; false = kill switch.
CARD_FLOW_GRADE_ESTIMATE_ENABLED=
# Python with vendor/cardgrading/requirements.txt. Empty uses apps/api/.venv/bin/python:
#   python3 -m venv .venv && .venv/bin/pip install --only-binary=:all: -r vendor/cardgrading/requirements.txt
CARDFLOW_GRADE_CARD_PYTHON=
# Grader limits. Debug overlay PNGs (~29 MB per grade) only when =1. Photos above
# CARDFLOW_GRADE_MAX_PIXELS (default 16000000) are downscaled before grading.
CARDFLOW_GRADE_DEBUG_IMAGES=
CARDFLOW_GRADE_MAX_PIXELS=
# Abuse rate limits per user and per client IP. Grades default 6/min, 100/day; detect (retakes)
# 20/min, 300/day. Whole-instance grades per day default 1000. false = all off (local only).
CARD_FLOW_GRADE_RATE_LIMIT=
CARD_FLOW_GRADE_RATE_PER_MIN=
CARD_FLOW_GRADE_RATE_PER_DAY=
CARD_FLOW_DETECT_RATE_PER_MIN=
CARD_FLOW_DETECT_RATE_PER_DAY=
CARD_FLOW_GRADE_DAILY_CAP=
# Monthly pre-grade quota per account (5 free / 30 premium, then extra credits). false = off.
CARD_FLOW_GRADE_QUOTA=
CARD_FLOW_PREMIUM_USER_IDS=
# Full 14-photo grade (docs/GRADE_FULL_MODE.md): on = offered to everyone with its own monthly
# allowance (free 2, Premium 25). Off/empty by default.
CARD_FLOW_GRADE_FULL_MODE=
# Speed-bump app key. Expo sends EXPO_PUBLIC_CARD_FLOW_APP_KEY as X-CardFlow-App-Key.
CARD_FLOW_APP_API_KEY=
# Extra-credit purchases. Leave off until Apple/Play IAP exists. Stub grants credits in local/dev.
CARD_FLOW_IAP_ENABLED=
CARD_FLOW_IAP_STUB=
# Global CardSight identify + CardMagic budget (default 750/month, free plan hard stop). false = off.
CARD_FLOW_CARDSIGHT_MONTHLY_BUDGET=
CARD_FLOW_CARDSIGHT_BUDGET=
# Slack-compatible incoming webhook for ops alerts (vendor 401/5xx, 5xx spike, CardSight ~80% usage).
CARD_FLOW_ALERT_WEBHOOK_URL=
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted.
# Default 0: use the TCP peer address and ignore the header (it can be spoofed).
CARD_FLOW_TRUST_PROXY_HOPS=
# Required in production (32+ random chars, keep secret): HMAC key for hashed emails in
# email_send_counts. Dev and tests use a fixed dev-only value when unset.
CARD_FLOW_SERVER_PEPPER=
# Email verification + password reset codes: "resend" or unset. Unset: codes are logged in
# development only, never sent in production (new sign-ups then can't verify).
CARD_FLOW_EMAIL_SENDER=
# With CARD_FLOW_EMAIL_SENDER=resend (verification + password reset codes via the Resend HTTP API):
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. PokeSniper <TODO-sender@pokesniper.app>
CARD_FLOW_EMAIL_FROM=
# Grader processes at once (each ~1 GB RAM; default 1) and callers allowed to wait for a
# slot (default 3). A full queue answers 503 + Retry-After.
MAX_CONCURRENT_GRADES=
MAX_QUEUED_GRADES=
# Not on the grade path. The API ignores these; kept only for the
# services/psa-grade-predictor experiment.
CARD_FLOW_PSA_GRADE_URL=
CARD_FLOW_PSA_GRADE_TOKEN=
CARD_FLOW_PSA_GRADE_TIMEOUT_MS=
# PokeTrace slab comps on Prepare. Server-only key. Fail soft when off.
CARD_FLOW_POKETRACE_ENABLED=
POKETRACE_API_KEY=
# Public host only, e.g. https://api.poketrace.com/v1. Host-only values are normalized. Never a phone secret.
POKETRACE_API_URL=
# Crash reporting. Empty = no-op (nothing is sent). Server-only; never put this on the phone.
# Create the API project at sentry.io, then paste its DSN. See docs/SENTRY.md.
SENTRY_DSN=
# Optional. staging or production. Empty uses Sentry's default.
SENTRY_ENVIRONMENT=
# Newsletter system (docs/NEWSLETTER.md). RESEND_API_KEY (above) also required for sending.
# Admin user ID authorized to create, preview, test, and send newsletters.
NEWSLETTER_ADMIN_USER_ID=
# From address for newsletters (verified on Resend).
NEWSLETTER_FROM=
# Physical mailing address (CAN-SPAM requirement).
NEWSLETTER_MAILING_ADDRESS=
# Secret for generating unsubscribe tokens (32+ random chars).
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Base URL for unsubscribe links (e.g. https://api.pokesniper.app).
BASE_URL=
# Enable weekly scheduled draft creation (default: false). See docs/NEWSLETTER.md for cron options.
NEWSLETTER_SCHEDULED_ENABLED=
# Cron schedule for weekly drafts (default: "0 9 * * 1" = Mondays 9 AM UTC).
NEWSLETTER_CRON_SCHEDULE=
# Prefer unset over empty. Empty PORT= is treated as 0 (random) — API defaults to 3001.
PORT=
# Temporary grade debug saving to apps/api/data/grade-debug (gitignored). Off unless =1.
CARDFLOW_GRADE_DEBUG=

# Railway + Litestream (docs/RAILWAY_DEPLOY.md). Leave empty locally.
# auto | replicate | restore-only | off (auto = replicate when LITESTREAM_BUCKET is set)
CARD_FLOW_LITESTREAM_MODE=
# true: refuse to boot without LITESTREAM_* (set in staging and production)
CARD_FLOW_BACKUPS_REQUIRED=
# true forces the "DB must be on the volume" check off Railway; false disables it (CI, local docker)
CARD_FLOW_REQUIRE_VOLUME=
# 1 during a DB restore only: /health 200, everything else 503, DB not opened
CARD_FLOW_MAINTENANCE=
LITESTREAM_BUCKET=
LITESTREAM_PATH=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_REQUIRE_CONTENT_MD5=
LITESTREAM_HEARTBEAT_URL=
