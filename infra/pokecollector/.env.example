# Copy to infra/pokecollector/.env locally if you want named values.
# Leave these empty. Never put vendor secrets on the device.
# Compose uses a local-only Postgres default when POSTGRES_PASSWORD is blank.

POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
CORS_ORIGINS=
BACKEND_PORT=
